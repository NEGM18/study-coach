# Data: tracked with DVC, never Git.
# Everything under ml/data/ is ignored EXCEPT the small .dvc pointer files
# and the .gitignore files DVC writes, so each dataset gets its own pointer.
/ml/data/**
!/ml/data/**/
!/ml/data/**/*.dvc
!/ml/data/**/.gitignore
*.parquet
*.flac
*.wav
*.m4a
*.mp3
# Small synthetic test clips are the one exception (see tests/fixtures/README.md).
!tests/fixtures/*.flac

# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
*.egg-info/
.ipynb_checkpoints/

# Flutter / Dart (apps/mobile)
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/config/*.json
!apps/mobile/config/*.json.example
apps/mobile/android/key.properties
*.jks
*.keystore
apps/mobile/ios/Pods/
*.iml

# Node (tooling only)
node_modules/

# OS / editors
.DS_Store
.vscode/
.idea/
